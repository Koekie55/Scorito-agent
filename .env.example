# Scorito credentials (part 1). Copy to .env and fill in. NEVER commit .env.
SCORITO_EMAIL=you@example.com
SCORITO_PASSWORD=changeme

# Personal-team auth (part 1). The OIDC ROPC (password) grant currently returns
# invalid_username_or_password for these creds, so the working fallback is a
# browser Bearer token: log into scorito.com, open DevTools > Network, copy the
# `access_token` (JWT) from an authenticated cyclingmanager API request, and
# paste it here. Used to pull your personal shortlist/teamselection/stageselection.
SCORITO_ACCESS_TOKEN=

#   B) Whole oidc blob: DevTools > Application > Local Storage > https://www.scorito.com,
#      copy the value of the key
#        oidc.user:https://idsrv.scorito.com:Scorito.Website.Client
#      (a JSON object with access_token/refresh_token/expires_at) and paste the
#      entire JSON here, single-quoted. auth.py extracts access_token + expiry.
SCORITO_OIDC_USER=

# Optional proxy for cyclingoracle/PCS scraping (blocker #3). requests-style URL,
# e.g. http://user:pass@host:port  or  socks5://host:port . Leave blank for direct.
SCRAPER_PROXY=
PCS_PROXY=

# Scorito public API base host (from jvdlaar/scorito + SPA bundle analysis)
SCORITO_CYCLING_API=https://cycling.scorito.com

# --- Discovered market/event/stage IDs (see data/scorito/markets_registry.json) ---
# TdF 2026: market 309, event 802, round stages 7298-7318, stage ids 2799-2819,
#           budget 45,000,000, captain factor 2, 206 riders. Snapshot: tdf2026/
# Giro 2026: market 306, event 791, stage ids 2778-2798, budget 42,000,000,
#            210 riders. Snapshot: giro2026/
# Vuelta 2026: market 310 (NOT open yet — re-run scripts/snapshot_market.py when live)
SCORITO_MARKET_ID=309
SCORITO_EVENT_ID=802

# Optional: override HTTP user-agent used by all scrapers
HTTP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) ScoritoAgent/0.1

# CyclingOracle (part 2) — base site
CYCLINGORACLE_BASE=https://www.cyclingoracle.com

# ProCyclingStats (part 3) — base site. NOTE: often Cloudflare-blocked (HTTP 522)
# from datacentre IPs; run PCS scraping from a residential/home network.
PCS_BASE=https://www.procyclingstats.com

# Rider-news email delivery (used by the 06:40, 11:30 and 20:00 schedule)
SCORITO_NEWS_SMTP_HOST=smtp.example.com
SCORITO_NEWS_SMTP_PORT=587
SCORITO_NEWS_SMTP_USERNAME=
SCORITO_NEWS_SMTP_PASSWORD=
SCORITO_NEWS_SMTP_SSL=false
SCORITO_NEWS_SMTP_STARTTLS=true
SCORITO_NEWS_EMAIL_FROM=scorito-news@example.com
SCORITO_NEWS_EMAIL_TO=you@example.com

# Microsoft Teams self-chat delivery for 18:15 Grand Tour predictability reports.
# Register a public-client Entra app with delegated User.Read, Chat.ReadBasic and
# ChatMessage.Send permissions, then run scripts/configure_teams_graph.py once.
SCORITO_TEAMS_CLIENT_ID=
SCORITO_TEAMS_TENANT_ID=
SCORITO_TEAMS_SELF_CHAT_ID=
# Immutable Entra object ID and sign-in UPN for the only account allowed to send.
SCORITO_TEAMS_EXPECTED_USER_ID=
SCORITO_TEAMS_EXPECTED_UPN=you@example.com
SCORITO_TEAMS_EXPECTED_USER=Quinten Koekenbier
# Optional path override. The default cache is protected with Windows DPAPI under LocalAppData.
SCORITO_TEAMS_TOKEN_CACHE=
# Optional short-lived fallback for diagnostics only; scheduled use should use the cache above.
SCORITO_TEAMS_ACCESS_TOKEN=
